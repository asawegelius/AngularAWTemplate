{
  "name": "angular-template",
  "version": "0.1.0-beta.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=development",
    "mock": "ng serve --configuration=mock",
    "mock:api": "json-server --watch mock-api/db.json --port 3000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "compodoc": "compodoc -p tsconfig.doc.json"
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@angular/animations": "^20.2.0",
    "@angular/cdk": "^20.2.0",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/material": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/platform-browser-dynamic": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@ngrx/effects": "^20.0.0",
    "@ngrx/entity": "^20.0.0",
    "@ngrx/router-store": "^20.0.0",
    "@ngrx/store": "^20.0.0",
    "@ngrx/store-devtools": "^20.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@compodoc/compodoc": "^1.2.1",
    "@ngrx/schematics": "^20.0.0",
    "@types/node": "^25.6.0",
    "jsdom": "^29.1.1",
    "json-server": "^0.17.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  }
}
