{
  "name": "angular-template",
  "version": "0.1.0-beta.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=development",
    "mock": "ng serve --configuration=mock",
    "mock:api": "json-server --watch mock-api/db.json --port 3000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "compodoc": "compodoc -p tsconfig.doc.json"
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/entity": "^21.1.1",
    "@ngrx/router-store": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@compodoc/compodoc": "^1.1.19",
    "@ngrx/schematics": "^21.1.1",
    "@types/node": "^22.15.0",
    "jsdom": "^29.0.2",
    "json-server": "^0.17.3",
    "typescript": "~5.9.0",
    "vitest": "^4.1.12"
  }
}
